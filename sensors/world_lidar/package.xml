<?xml version="1.0"?>
<package format="2">
  <name>xgc2_world_lidar</name>
  <version>0.1.0</version>
  <description>ROS-free world-frame lidar and surface-sampling numerical libraries.
    Live Scene sensing is owned by the C++ Scene adapter.</description>
  <maintainer email="lxk@todo.todo">lxk</maintainer>
  <license>MIT</license>
  <license>GPL-2.0-only</license> <!-- optional original-core GPU linkage -->

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>libpcl-all-dev</build_depend>
  <build_export_depend>libpcl-all-dev</build_export_depend>
  <exec_depend>libpcl-all</exec_depend>
  <depend>eigen</depend>
  <depend version_gte="0.6.0-6~focal">libxgc2-math-dev</depend>

</package>
