# Shared native GPU library is supplied by libxgc2-sensing-gpu.
option(XGC_WORLD_LIDAR_GPU "Compile the shared GPU sensing client" ON)
if(XGC_WORLD_LIDAR_GPU)
  find_path(XGC2_SENSING_INCLUDE xgc2_sensing/gpu.h REQUIRED)
  add_library(${PROJECT_NAME}_cloud_gpu STATIC src/shared_cloud_gpu.cpp)
  target_include_directories(${PROJECT_NAME}_cloud_gpu PUBLIC include ${PCL_INCLUDE_DIRS} ${XGC2_SENSING_INCLUDE})
  target_link_libraries(${PROJECT_NAME}_cloud_gpu PUBLIC ${PROJECT_NAME}_cloud_cpu ${PCL_LIBRARIES} ${CMAKE_DL_LIBS})
  if(TARGET shared_cloud_cpu_node)
    target_compile_definitions(shared_cloud_cpu_node PRIVATE XGC_WORLD_LIDAR_GPU=1)
    target_link_libraries(shared_cloud_cpu_node PRIVATE ${PROJECT_NAME}_cloud_gpu)
  endif()
endif()
