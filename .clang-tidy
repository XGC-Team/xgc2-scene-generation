---
Checks: >
  -*,
  clang-analyzer-*,
  bugprone-*,
  performance-*,
  portability-*,
  modernize-use-nullptr,
  modernize-use-override,
  readability-container-size-empty,
  readability-inconsistent-declaration-parameter-name,
  readability-redundant-*
WarningsAsErrors: '*,-clang-analyzer-core.uninitialized.UndefReturn,-clang-analyzer-core.DivideZero'
HeaderFilterRegex: '.*cluttered_environment/(include|src)/.*'
AnalyzeTemporaryDtors: false
CheckOptions:
  - key: bugprone-argument-comment.StrictMode
    value: 'false'
