#!/usr/bin/env python3
"""Own the isolated test node's socket grant and process lifetime."""
import signal
import os
import subprocess
import sys
import tempfile
from pathlib import Path
import roslib.packages

executable = os.environ.get('XGC2_WORLD_LIDAR_FIXTURE') or roslib.packages.find_node('xgc2_world_lidar', 'world_lidar_node')[0]
with tempfile.TemporaryDirectory(prefix='xgc2-lidar-test-') as directory:
    process = subprocess.Popen([executable, '_xrpc_socket:='+str(Path(directory)/'control.sock'),
                                '_target_id:=fixture']+sys.argv[1:])
    def stop(signum, frame):
        process.send_signal(signum)
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    try:
        sys.exit(process.wait())
    finally:
        if process.poll() is None:
            process.terminate()
            try: process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                process.kill(); process.wait()
